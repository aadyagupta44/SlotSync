# =============================================================================
# SlotSync - environment template
# Copy to `.env` and fill in the values.  `.env` is git-ignored.
#   cp .env.example .env
# =============================================================================

# ---- PostgreSQL -------------------------------------------------------------
# Local docker-compose uses these to create the database container.
POSTGRES_DB=slotsync
POSTGRES_USER=slotsync
POSTGRES_PASSWORD=CHANGE_ME_local_password

# What the backend connects to.
# Local (docker-compose):  jdbc:postgresql://postgres:5432/slotsync
# Local (running backend outside docker): jdbc:postgresql://localhost:5432/slotsync
# Neon (production): jdbc:postgresql://<host>.neon.tech/<db>?sslmode=require
SPRING_DATASOURCE_URL=jdbc:postgresql://postgres:5432/slotsync
SPRING_DATASOURCE_USERNAME=slotsync
SPRING_DATASOURCE_PASSWORD=CHANGE_ME_local_password

# ---- Redis ------------------------------------------------------------------
# Local (docker-compose): redis://redis:6379
# Upstash (production):   rediss://default:<PASSWORD>@<host>.upstash.io:6379
SPRING_DATA_REDIS_URL=redis://redis:6379

# ---- Kafka / Redpanda -------------------------------------------------------
# Local (docker-compose): redpanda:9092
# Upstash / Confluent: <host>:9092 plus SASL settings below
SPRING_KAFKA_BOOTSTRAP_SERVERS=redpanda:9092

# Leave blank for local plaintext. For a managed cluster set:
#   KAFKA_SECURITY_PROTOCOL=SASL_SSL
#   KAFKA_SASL_MECHANISM=SCRAM-SHA-256
#   KAFKA_SASL_USERNAME=CHANGE_ME
#   KAFKA_SASL_PASSWORD=CHANGE_ME
KAFKA_SECURITY_PROTOCOL=
KAFKA_SASL_MECHANISM=
KAFKA_SASL_USERNAME=
KAFKA_SASL_PASSWORD=

# ---- Application tuning -----------------------------------------------------
# How long a waitlist offer stays claimable before it cascades to the next person.
SLOTSYNC_OFFER_TTL_SECONDS=300
# How many times one waitlist entry may ignore an offer before it is dropped.
SLOTSYNC_MAX_MISSED_OFFERS=2
# Per-tenant API rate limit (token bucket).
SLOTSYNC_RATELIMIT_CAPACITY=120
SLOTSYNC_RATELIMIT_REFILL_PER_SECOND=20

# ---- Frontend ---------------------------------------------------------------
# Base URL the React app calls. Empty string = same origin (nginx proxies /api).
VITE_API_BASE_URL=
